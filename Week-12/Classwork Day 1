#Example 2
import tkinter as tk
def show_page(frame):
    home_page.pack_forget()
    course_page.pack_forget()
    registration_page.pack_forget()
    frame.pack(fill = "both", expand = 1)

root = tk.Tk()
root.title("Window 1")
root.geometry("500x500")

main_menu = tk.Menu(root)
f1 = tk.Menu(main_menu)
f1.add_command(label = "Open")
f1.add_command(label = "Save")
f1.add_separator()
f1.add_command(label = "Exit", command = root.destroy)
main_menu.add_cascade(label = "File", menu = f1)

f2 = tk.Menu(main_menu)
f2.add_command(label = "Courses", command = lambda: show_page(course_page))
f2.add_command(label = "Registration", command = lambda: show_page(registration_page))
main_menu.add_cascade(label = "Services", menu = f2)
root.config(menu = main_menu)

home_page = tk.Frame(root)
l1 = tk.Label(home_page,text = "Home Page")
l1.pack()

b = tk.Button(home_page, text = "ok")
b.pack()

course_page = tk.Frame(root)
l2 = tk.Label(course_page, text = "Courses Page")
l2.pack()

registration_page = tk.Frame(root)
l3 = tk.Label(registration_page, text = "Registration Page")
l3.pack()

show_page(home_page)
root.mainloop()