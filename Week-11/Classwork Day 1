#Example 2

import tkinter as tk

def welcome():
    l3.config(text = "Welcome "+ e1.get()+ " "+ e2.get())

root = tk.Tk()

root.title("Greeting")
root.geometry("500x500")
root.config(bg = "green")

l1 = tk.Label(root, text = "First Name: ", bg = "green", fg = "white", font = ("Arial", 14))
l1.grid(row = 0, column = 0, padx = 20, pady = 20)

e1 = tk.Entry(root)
e1.grid(row = 0, column = 1, padx = 20, pady = 20)

l2 = tk.Label(root, text = "Last Name: ", bg = "green", fg = "white", font = ("Arial", 14))
l2.grid(row = 1, column = 0)

e2 = tk.Entry(root)
e2.grid(row = 1, column = 1, padx = 20, pady = 20)

b = tk.Button(root, text = "Submit", command = welcome)
b.grid(row = 2, column = 0, padx = 20, pady = 20, columnspan = 2)

l3 = tk.Label(root, bg = "green", fg = "white", font = ("Arial", 14))
l3.grid(row = 3, column = 0, columnspan = 2)

root.mainloop()